# Database Configuration
POSTGRES_USER=ahlquran_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ahlquran_db
DATABASE_URL=postgresql+asyncpg://ahlquran_user:replace-with-a-long-random-password@db:5432/ahlquran_db

# Application Security
SECRET_KEY=replace-with-at-least-32-random-characters
APP_ENV=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:3000"]

# Host port docker-compose publishes the API on (container always listens on 8000).
# If you change it, set NEXT_PUBLIC_API_BASE_URL=http://localhost:<port>/api/v1
# in Ahl-El-Quran-Front/.env.local to match.
BACKEND_PORT=8000
DEBUG=false

# Initial administrator bootstrap (set a unique password in production)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password
